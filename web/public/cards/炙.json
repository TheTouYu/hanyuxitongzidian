 "sections": [
  {
   "key": "benyi",
   "label": "本義",
   "text": "从肉从火，象意用火燒烤肉。zhì，《說文》：“炮肉也。从肉在火上。凡炙之屬皆从炙。，籀文。之石切。”"
  },
  {
   "key": "zhuanyi",
   "label": "轉義",
   "text": "由烤肉引申指熱。《廣雅》：“爇也。”"
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "音源字，源自烤肉時所發出的聲音。因古燒石炙肉，故義音同“石”。《易·晉》：“晉如鼫鼠。”“鼫”，馬王堆漢墓帛書本作“炙”。"
  },
  {
   "key": "shengmu",
   "label": "聲母擬態",
   "text": "zh「凿总」取「凿」：火著肉而炙之，聲隨肉裂（推）。"
  },
