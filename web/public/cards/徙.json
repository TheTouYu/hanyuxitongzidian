 "sections": [
  {
   "key": "benyi",
   "label": "本義",
   "text": "从行从步。“行”，指大道；“步”，指徒步。象意大道上人來人往，表示徜徉、徘徊。xǐ，《廣雅》：“仿佯，徙倚也。”或象意行人的成群結隊，表示遷移。“行”或省作“彳、亍”，“步”或省作“止”，義同。《說文》：“𨑭（xǐ），迻也。从辵止聲。{{benyi/01.png}}，徙或从彳。{{benyi/02.png}}，古文徙。斯氏切。”",
   "gdir": "inline/徙"
  },
  {
   "key": "zhuanyi",
   "label": "轉義",
   "text": "由遷移引申指躲避、謫戍、流放。《玉篇》：“移也。遷也。避也。”"
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "音源字。源自群體行走的腳步聲。義音同“師”：《集韻》：“籭，《說文》：‘竹器也。可以取粗去細。’或作簛、簁、篩。”"
  },
  {
   "key": "shengmu",
   "label": "聲母擬態",
   "text": "x「续消」取「续」：人行相續，移徙不絕（推）。"
  },
