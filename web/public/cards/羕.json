 "sections": [
  {
   "key": "benyi",
   "label": "本義",
   "text": "从永从羊。“永”，指有支流的大河；从“羊”，象意水流象羊群一樣浩蕩，白浪起伏。yàng，《說文》：“水長也。从永，羊聲。《詩》曰：‘江之羕矣。’餘亮切。”"
  },
  {
   "key": "zhuanyi",
   "label": "轉義",
   "text": "由水流的浩蕩，引申指長大。《廣韻》：“長大也。”"
  },
  {
   "key": "shengmu",
   "label": "聲母擬態",
   "text": "y「零聲母」不系：水長浩蕩，聲不系於七組（照實）。"
  },
