 "sections": [
  {
   "key": "benyi",
   "label": "本義",
   "text": "从臼从𠬞抱午形。象意雙手抱杵在臼中搗杵的樣子。chōng，《說文》：“搗粟也。从廾持杵臨臼上。午，杵省也。古者雝父初作舂。書容切。”"
  },
  {
   "key": "zhuanyi",
   "label": "轉義",
   "text": "由舂杵之狀，引申指衝擊。《正字通》：“與衝通。”《玉篇》：“擣也。”"
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "音源字，源自舂杵聲。"
  },
  {
   "key": "shengmu",
   "label": "聲母擬態",
   "text": "ch「刺持」取「刺」：杵下刺臼，撞擊有聲（推）。"
  },
  {
   "key": "zizu",
