 "sections": [
  {
   "key": "benyi",
   "label": "本义",
   "text": "桀，jié：从舛在木上（舛＝分张两足，木＝树）。象意有二——①立于树上，表示高出（分化作「傑」）；②陈尸于树上，表示分剖并挂起风干（《說文》「磔也……渠列切」，分化作「磔」）。",
   "cites": [],
   "gimgs": [
    "01.png",
    "02.png",
    "03.png",
    "04.png",
    "05.png"
   ]
  },
  {
   "key": "zhuanyi",
   "label": "转义",
   "text": "由高出引申为特立、俊杰；由分剖引申为裂开、磔裂、张布；又借为夏桀之「桀」（凶暴）。",
   "cites": []
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "借音字；因有立高处义，义音同「匃」（《墨子·備梯》「直桀」孫詒讓引作「置楬」；《詩·衛風》「庶士有朅」《釋文》「朅，《韓詩》作桀」）。",
   "cites": []
  },
  {
   "key": "shengmu",
   "label": "声母拟态",
   "text": "j「聚决」取「决」：兩足分張（舛）而立於木上，決然特立。",
   "cites": []
  },
