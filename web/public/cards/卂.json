 "sections": [
  {
   "key": "benyi",
   "label": "本義",
   "text": "甲骨文本从水才聲，與“𡿧”同源，指水災。“汛”的初文，指雨季的江河水位暴漲。xùn，《廣韻》：“水皃。”"
  },
  {
   "key": "zhuanyi",
   "label": "轉義",
   "text": "由江河的暴漲，引申指迅速。《玉篇》：“疾飛也。亦作迅。”"
  },
  {
   "key": "bianzheng",
   "label": "辯證",
   "text": "由于西周金文將“水”置于右上角，小篆遂演變成{{bianzheng/01.png}}，近似{{bianzheng/02.png}}（飛）字沒有羽毛。故《說文》：“疾飛也。从飛而羽不見。凡卂之屬皆从卂。息晉切。”因此，析形不確。",
   "gdir": "inline/卂"
  },
  {
   "key": "shengmu",
   "label": "聲母擬態",
   "text": "x「续消」取「续」：水漲續而疾（推）。"
  },
