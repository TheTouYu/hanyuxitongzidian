  "name": "𠂔"
 },
 "aliases": [
  "𠥽"
 ],
 "sections": [
  {
   "key": "benyi",
   "label": "本义",
   "text": "甲骨文从丰从𠂔。丰指艸的長勢茂盛，𠂔指集束。象意將豐茂的草類捆成一束。"
  },
  {
   "key": "zhuanyi",
   "label": "转义",
   "text": "草束意味著收割，故引申指停止。zǐ，《集韻》：「止也。」"
  },
  {
   "key": "bianzheng",
   "label": "辩证",
   "text": "西周金文演變較大，已看不出丰字，小篆从之，故《說文》「止也。从𣎵盛而一橫止之」析形不確。另巿、𠂔形近故或相混（巿从巾，指佩巾）；朿、𣎳、市亦然：朿本指刺，𣎳本指麻引申分削，市本指廟會。"
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "借音字。因有停止意，而義音同次（《易·夬》「其行次且」，《釋文》次本亦作趑）。"
  },
  {
   "key": "shengmu",
   "label": "声母拟态",
   "text": "z「凿总」取「总」：草束總聚而成把（推）。"
  },
  {
   "key": "zizu",
   "label": "字族衍义",
   "groups": [
    {
     "no": "①",
     "title": "指艸束，表示聚束",
     "rows": [
      [
       "秭",
       "zī",
       "",
       "五稯為秭，二百把禾；一曰數億至萬曰秭。"
      ],
      [
       "泲",
       "jǐ",
       "",
       "沇也，濟水東流源于王屋山。"
      ],
      [
       "胏",
       "zǐ",
       "",
       "食所遺也，噬乾肉；帶骨殘肉。"
      ],
      [
       "䪢",
       "jī",
       "",
       "墜也，切碎的菜。"
      ],
      [
       "𦬷",
       "zǐ",
       "",
       "羮菜也，作羹之菜。"
      ],
      [
       "笫",
       "zǐ",
       "",
       "床簀也，竹編的床墊；床格謂之笫。"
      ]
     ]
    },
    {
     "no": "②",
     "title": "指止，跟「次」義同",
     "rows": [
      [
       "𡰾",
       "cī",
       "",
       "𧠥覷，窺觀也，與次同，盜視。"
      ],
      [
       "𧿲",
       "zhuì",
       "",
       "足不前也，次且不前的樣子；bó，足擊。"
      ]
     ]
    },
    {
     "no": "③",
     "title": "形近字朿、巿、𣎳、市之訛",
     "rows": [
      [
       "𠛔",
       "chǐ",
       "",
       "割物也；𠚷同𠛔。"
      ],
      [
       "㾅",
       "zǐ",
       "",
       "瑕也，瑕疵即痣；一曰病也。"
      ],
      [
       "𦍜",
       "bó",
       "",
       "羯也，閹割；pò，音潑。"
      ],
      [
       "牬",
       "bèi",
       "",
       "體長，牬；牛脊長。"
      ],
      [
       "𢂍",
       "bō",
       "",
       "巾也，应从巿。"
      ],
      [
       "趀",
       "cī",
       "",
       "蒼卒也，腳步雜亂。"
      ],
      [
       "𨥦",
       "qí",
       "",
       "利也，鋒利；讀若齊。"
      ],
      [
       "柹",
       "shì",
       "",
       "赤實果，柿子；fèi，削下的木片。"
      ],
      [
       "𤝮",
       "lù",
       "",
       "箭射也，音捋。"
      ],
      [
       "姊",
       "zǐ",
       "",
       "女兄也，姐姐。"
      ]
     ]
