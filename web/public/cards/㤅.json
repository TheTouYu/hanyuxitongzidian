 "sections": [
  {
   "key": "benyi",
   "label": "本义",
   "text": "「愛」與「㤅」本同一字；戰國古文从心旡聲——旡即欠，張著口的樣子，从心指心理活動（《集韻》「㤅，或作愛，古作𢟪、𢛭」）。",
   "cites": [],
   "gimgs": [
    "01.png",
    "02.png",
    "03.png",
    "04.png",
    "05.png",
    "06.png",
    "08.png",
    "09.png"
   ]
  },
  {
   "key": "zhuanyi",
   "label": "转义",
   "text": "由心裡想得到、據為己有，引申為喜歡、愛好、吝惜（《字彙》「好樂也、吝也」，《正韻》「親也、恩也、惠也、憐也、寵也」）；或專指男女情愛。",
   "cites": []
  },
  {
   "key": "bianzheng",
   "label": "辩证",
   "text": "戰國古文或加「夊」，小篆从之，故《說文》「愛，行皃。从夊，㤅聲」所析不確。",
   "cites": []
  },
  {
   "key": "shengmu",
   "label": "声母拟态",
   "text": "零聲母（今讀 ài），緒論七組未列，不系（照實）。",
   "cites": []
  },
