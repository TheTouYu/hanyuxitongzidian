 "sections": [
  {
   "key": "benyi",
   "label": "本義",
   "text": "甲骨文象以玄束牛之形，指用繩繫牛。qiān，《說文》：“引前也。从牛，象引牛之縻也。玄聲。苦堅切。”"
  },
  {
   "key": "zhuanyi",
   "label": "轉義",
   "text": "由牽牛引申指導引、挽攬、牽連。《廣韻》：“引也。挽也。連也。”或引申指拉船的繩索。qiàn，《增韻》：“挽舟索。一名百丈。”"
  },
  {
   "key": "shengmu",
   "label": "聲母擬態",
   "text": "q「亲缺」取「亲」：繩繫牛鼻，親而引之（推）。"
  },
  {
   "key": "zizu",
   "label": "字族衍義",
