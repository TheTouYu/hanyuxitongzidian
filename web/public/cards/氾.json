  "汎",
  "𣲆"
 ],
 "sections": [
  {
   "key": "benyi",
   "label": "本义",
   "text": "从水从ㄗ。ㄗ為人跪跽之狀，表示歇息；从水，象意水流停駐不走。"
  },
  {
   "key": "zhuanyi",
   "label": "转义",
   "text": "由水流停住不走，引申指洪水氾濫、漫溢（《說文》濫也）。"
  },
  {
   "key": "bianzheng",
   "label": "辩证",
   "text": "ㄗ在漢字系統中是常用部件，楷化後產生不同寫法，㔾只是其中；因單从㔾聲的字多與氾音義同，故也歸入，可視為氾省聲，實即卩。"
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "本ㄗ聲。義音跟乏、凡通（《史記·屈原賈生列傳》「氾兮若不繋之舟」）。"
  },
  {
   "key": "shengmu",
   "label": "声母拟态",
   "text": "f「附分」取「分」：氾濫分溢（推）。"
  },
  {
   "key": "zizu",
   "label": "字族衍义",
   "groups": [
    {
     "no": "①",
     "title": "指氾濫，表示浮泛、前突",
     "rows": [
      [
       "范",
       "fàn",
       "",
       "艸也，从艸氾聲；一說虫名。"
      ],
      [
       "𦨲",
       "fán",
       "",
       "舷也、舟也。"
      ],
      [
       "𨊠",
       "fàn",
       "",
       "車軾前也；立當前軓。"
      ],
      [
       "犯",
       "fàn",
       "",
       "侵也，从犬㔾聲；侵犯。"
      ],
      [
       "𧍙",
       "fàn",
       "",
       "蜂也。"
      ],
      [
       "𡴱",
       "hù",
       "",
       "扈，古作𡴱；止也。"
      ],
      [
       "𤼥",
       "jī",
       "",
       "古文躋字，升高當自卪。"
      ]
     ]
    },
    {
     "no": "②",
     "title": "指水的停駐，表示法式、落入",
     "rows": [
      [
       "笵",
       "fàn",
       "",
       "法也，从竹氾聲，古法有竹刑簡書。"
      ],
      [
       "範",
       "fàn",
       "",
       "範軷也，从車笵省聲，出行祭道神。"
      ],
      [
       "䀀",
       "fàn",
       "",
       "《博雅》杯也。"
      ],
      [
       "𣳜",
       "biǎn",
       "",
       "落葬，同窆。"
      ],
      [
       "𥐗",
       "biān",
       "",
       "以石刺病也。"
      ]
     ]
    },
    {
     "no": "③",
     "title": "夗字之省，含曲義",
     "rows": [
      [
       "𢖭",
       "yuàn",
       "",
       "怨，古作𢖭；恚也。"
      ]
     ]
    },
    {
     "no": "④",
     "title": "形近字丏、阝、乃之訛",
     "rows": [
      [
       "𡦻",
       "bīn",
       "",
       "疑𡧍字之訛，音賓。"
      ],
      [
       "𦔶",
       "yé",
       "",
       "音義闕，恐是耶字之訛。"
      ],
      [
       "𣎿",
       "duǒ",
       "",
       "與朶同，朵之訛字。"
      ]
     ]
    }
   ]
