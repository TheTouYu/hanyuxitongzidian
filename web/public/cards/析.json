 "sections": [
  {
   "key": "benyi",
   "label": "本義",
   "text": "从斤从木。可以象意砍伐樹木；也可以指砍破木頭。xī，《說文》：“破木也。一曰折也。从木从斤。先激切。”"
  },
  {
   "key": "zhuanyi",
   "label": "轉義",
   "text": "由砍開木頭，引申指分開、分散、割裂。《廣韻》：“分也。”"
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "音源字，源自木裂聲。因有分散之義，而義音同“斯”：《集韻》：“蜤，蟲名。《爾雅》：‘蜤螽，蜙蝑。’通作斯。”"
  },
  {
   "key": "shengmu",
   "label": "聲母擬態",
   "text": "x「续消」取「消」：斤劈木開，析然而分（推）。"
  },
