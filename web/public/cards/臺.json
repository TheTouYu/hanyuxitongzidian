 "sections": [
  {
   "key": "benyi",
   "label": "本义",
   "text": "商代甲骨文本从高至聲——「高」指高臺，从「至」象意高到極點，表示特別高。配圖：河南登封觀星臺。"
  },
  {
   "key": "zhuanyi",
   "label": "转义",
   "text": "象臺觀一樣高而平的東西（櫃臺、灶臺）；古謂陵墓曰臺；高臺用於觀遠或作基礎→等待（《廣雅》待也）、支撐底座（《方言》支也）。"
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "本「至」聲。因有高挺之意，義音同「台」（𩦽與駘同），今也將「臺」簡化作「台」。"
  },
  {
   "key": "shengmu",
   "label": "声母拟态",
   "text": "t「涂突」取「突」：高臺突起（推）。"
  },
  {
   "key": "zizu",
   "label": "字族衍义",
   "groups": [
    {
     "no": "①",
     "title": "指臺形，表示高平之物",
     "rows": [
      [
       "薹",
       "tái",
       "艸",
       "芸薹，菜名，即油菜；或指薹草即夫須。"
      ],
      [
       "籉",
       "tái",
       "竹",
       "笠子，可禦雨；戴在頭上如高臺。"
      ],
      [
       "檯",
       "tái",
       "木",
       "木名；今指桌子、几案。"
      ],
      [
       "擡",
       "tái",
       "手",
       "擡揌，動也；舉也。"
      ],
      [
       "𤗿",
       "tǎi",
       "片",
       "吳人謂逆剡木曰𤗿，从下往上削木頭。"
      ],
      [
       "𧭏",
       "tāi",
       "言",
       "諟也，訂正，意即在文章的擡頭空白處書寫。"
      ]
     ]
    },
    {
     "no": "②",
     "title": "指臺狀，表示僵挺、木然的樣子",
     "rows": [
      [
       "𩦽",
       "tái",
       "馬",
       "與駘同，馬不進。"
      ],
      [
       "儓",
       "tái",
       "人",
       "陪儓，臣也；輿儓也；醜也、當也；tài，癡皃。"
      ],
      [
       "㘆",
       "tǎi",
       "口",
       "㘆𠷂，言不正；言舛也。"
      ],
      [
       "𤐽",
       "tái",
       "火",
       "同炱，煙氣凝積而成的黑灰，懸垂於灶房樓枕上。"
      ],
      [
       "懛",
       "dāi",
       "心",
       "懛剴，失志皃；懛呆，癡呆笨拙。"
      ],
      [
       "𪒴",
       "tái",
       "黑",
       "黑也；大黑之皃。"
      ],
      [
