 "sections": [
  {
   "key": "benyi",
   "label": "本义",
   "text": "厶，niǎo／sī／mǒu：象雄性器之形，與「㠯」（以）同源，為其異體寫法（《正字通》引鄭樵：「厶非自營義；音鳥，男子之勢」）。《說文》「奸衺也，自營為厶」以閉環立說，析形不確。既與㠯同字，故亦列為一級字根，其諧聲字（私、𦮺）另見字族表。",
   "cites": [],
   "gimgs": [
    "01.png",
    "02.png",
    "03.png",
    "04.png",
    "05.png",
    "06.png"
   ]
  },
  {
   "key": "zhuanyi",
   "label": "转义",
   "text": "引申為私自、私下；又為「某」之古字。",
   "cites": []
  },
  {
   "key": "bianzheng",
   "label": "辩证",
   "text": "厶與㠯、以、氏、巳為一字之異寫，非別字；故厶不附於㠯之下，自為一級字根。",
   "cites": []
  },
  {
   "key": "yinyuan",
   "label": "音源",
   "text": "本「㠯」聲。",
   "cites": []
  },
  {
   "key": "shengmu",
   "label": "声母拟态",
   "text": "s「失收」取「收」：s（今讀 sī）「失收」取「收」：私藏而收（推）。",
   "cites": []
  },
  {
   "key": "zixing",
   "label": "字形",
   "text": "共 6 形，见卡头字形带。",
